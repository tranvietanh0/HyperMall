          "name": "Apple"
        }
      }
    ],
    "page": 0,
    "size": 20,
    "totalElements": 100,
    "totalPages": 5,
    "first": true,
    "last": false
  }
}
```

### Get Product by ID

```http
GET /api/products/{id}
```

### Get Product by Slug

```http
GET /api/products/slug/{slug}
```

### Get Products by Category

```http
GET /api/products/category/{categoryId}?page=0&size=20
```

---

## Category Endpoints (Public)

### Get All Categories (Flat)

```http
GET /api/categories
```

### Get Category Tree (Hierarchical)

```http
GET /api/categories/tree
```

**Response:**
```json
{
  "success": true,
  "data": [
    {
      "id": 1,
      "name": "Electronics",
      "slug": "electronics",
      "image": "https://...",
      "children": [
        {
          "id": 2,
