          "slug": "laptops",
          "children": null
        }
      ]
    }
  ]
}
```

### Get Category by ID

```http
GET /api/categories/{id}
```

### Get Category by Slug

```http
GET /api/categories/slug/{slug}
```

---

## Brand Endpoints (Public)

### Get All Brands

```http
GET /api/brands
```

### Get Brand by ID

```http
GET /api/brands/{id}
```

---

## Cart Endpoints

### Get Cart

```http
GET /api/cart
Authorization: Bearer <access_token>
```

**Response:**
```json
{
  "success": true,
  "data": {
    "userId": 1,
