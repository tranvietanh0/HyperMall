    @apply inline-flex items-center justify-center gap-2 rounded-lg px-5 py-2.5 font-medium transition-all duration-200 focus:ring-2 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50;
  }

  .btn-primary {
    @apply btn bg-primary-900 text-white hover:bg-primary-800 focus:ring-primary-500 active:scale-[0.97] transition-transform;
  }

  .btn-secondary {
    @apply btn bg-secondary-100 text-secondary-900 hover:bg-secondary-200 focus:ring-secondary-300 active:scale-[0.97];
  }

  .btn-accent {
    @apply btn bg-accent-600 text-white hover:bg-accent-700 focus:ring-accent-500 active:scale-[0.97];
  }

  .btn-outline {
    @apply btn border border-secondary-200 bg-white text-secondary-900 hover:bg-secondary-50 focus:ring-secondary-300 active:scale-[0.97];
  }

  .btn-ghost {
    @apply btn bg-transparent text-secondary-700 hover:bg-secondary-100 focus:ring-secondary-300;
  }

  .input {
    @apply w-full rounded-lg border border-secondary-200 bg-white px-4 py-2.5 text-sm text-secondary-900 placeholder:text-secondary-400 transition-all focus:border-primary-500 focus:ring-4 focus:ring-primary-50;
  }

  .input-error {
    @apply border-red-500 focus:border-red-500 focus:ring-red-100;
  }

  .label {
    @apply mb-1.5 block text-sm font-medium text-secondary-700;
  }

  .error-message {
    @apply mt-1.5 text-xs text-red-500 font-medium;
  }

  .card {
    @apply rounded-xl border border-secondary-100 bg-white shadow-sm;
  }

  .card-hover {
    @apply card transition-all duration-300 hover:border-secondary-200 hover:shadow-lg hover:-translate-y-1;
  }

  .badge {
    @apply inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider;
  }

  .badge-primary {
    @apply badge bg-primary-100 text-primary-900;
  }

  .badge-accent {
    @apply badge bg-accent-100 text-accent-700;
  }

  .badge-success {
    @apply badge bg-green-100 text-green-700;
  }

  .badge-warning {
    @apply badge bg-amber-100 text-amber-700;
  }

  .badge-error {
    @apply badge bg-red-100 text-red-700;
  }

  .container {
    @apply mx-auto max-w-7xl px-4 sm:px-6 lg:px-8;
  }

  .section {
    @apply py-8 md:py-12;
  }

  .heading-1 {
    @apply text-4xl font-extrabold tracking-tight text-primary-900 md:text-6xl;
  }

  .heading-2 {
    @apply text-2xl font-bold text-primary-900 md:text-3xl;
  }

  .heading-3 {
    @apply text-lg font-bold text-primary-900 md:text-xl;
  }

  .text-link {
    @apply text-accent-600 font-medium hover:text-accent-700 hover:underline;
  }

  .hm-surface {
    @apply rounded-2xl bg-white border border-secondary-100 shadow-sm;
  }

  .hm-section-title {
    @apply text-xl font-bold tracking-tight text-primary-900 md:text-2xl;
  }

  .hm-gradient-overlay {
    background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.6) 100%);
  }

  /* Glassmorphism surface */
  .glass {
    @apply bg-white/60 backdrop-blur-xl border border-white/20 shadow-lg;
  }
}

@layer utilities {
  /* ── Existing animations ── */
  .animate-fade-up {
    animation: fadeUp 0.6s ease-out both;
  }

  .animate-fade-in {
    animation: fadeIn 0.5s ease-out both;
  }

  .animate-pop-in {
    animation: popIn 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  /* ── New animation utilities ── */
  .animate-shimmer {
    animation: shimmer 2.5s ease-in-out infinite;
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float 6s ease-in-out 1.5s infinite;
  }

  .animate-pulse-glow {
    animation: pulseGlow 2s ease-in-out infinite;
  }

  .animate-blur-in {
    animation: blurIn 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .animate-bounce-subtle {
    animation: bounceSubtle 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .animate-gradient-shift {
    background-size: 200% 200%;
    animation: gradientShift 4s ease infinite;
  }

  .animate-countdown-pulse {
    animation: countdownPulse 1s ease-in-out infinite;
  }

  .animate-slide-in-right {
    animation: slideInRight 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .animate-slide-in-left {
    animation: slideInLeft 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  /* ── Line clamp utilities ── */
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Scroll-reveal system ── */
  [data-reveal] {
    opacity: 0;
    transition: opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
                transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  [data-reveal="up"] {
    transform: translateY(30px);
  }

  [data-reveal="down"] {
    transform: translateY(-30px);
  }

  [data-reveal="left"] {
    transform: translateX(40px);
  }

  [data-reveal="right"] {
    transform: translateX(-40px);
  }

  [data-reveal="scale"] {
    transform: scale(0.92);
  }

  [data-reveal="fade"] {
    /* just opacity, no transform */
  }

  /* Revealed state */
  [data-revealed="true"] {
    opacity: 1;
    transform: translateY(0) translateX(0) scale(1);
  }

  /* Stagger delay support via CSS custom property */
  [data-reveal-delay="1"] { transition-delay: 0.06s; }
  [data-reveal-delay="2"] { transition-delay: 0.12s; }
  [data-reveal-delay="3"] { transition-delay: 0.18s; }
  [data-reveal-delay="4"] { transition-delay: 0.24s; }
  [data-reveal-delay="5"] { transition-delay: 0.30s; }
  [data-reveal-delay="6"] { transition-delay: 0.36s; }
  [data-reveal-delay="7"] { transition-delay: 0.42s; }
  [data-reveal-delay="8"] { transition-delay: 0.48s; }
  [data-reveal-delay="9"] { transition-delay: 0.54s; }
  [data-reveal-delay="10"] { transition-delay: 0.60s; }
  [data-reveal-delay="11"] { transition-delay: 0.66s; }
  [data-reveal-delay="12"] { transition-delay: 0.72s; }

  /* ── Link underline slide ── */
  .link-underline {
    position: relative;
  }

  .link-underline::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1.5px;
    background-color: currentColor;
    transition: width 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .link-underline:hover::after {
    width: 100%;
  }
}

/* ══════════════════════════════════════════
   KEYFRAMES
   ══════════════════════════════════════════ */

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(18px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popIn {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12px); }
}

@keyframes pulseGlow {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.3);
  }
  50% {
    box-shadow: 0 0 20px 6px rgba(34, 197, 94, 0.15);
  }
}

@keyframes blurIn {
  from {
    opacity: 0;
    filter: blur(8px);
    transform: scale(0.97);
  }
  to {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }
}

@keyframes bounceSubtle {
  0% { transform: scale(1); }
  40% { transform: scale(1.06); }
  70% { transform: scale(0.98); }
  100% { transform: scale(1); }
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes countdownPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes skeletonPulse {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes ripple {
  0% {
    transform: scale(0);
    opacity: 0.5;
  }
  100% {
    transform: scale(4);
    opacity: 0;
  }
}

/* ══════════════════════════════════════════
   PAGE TRANSITIONS
   ══════════════════════════════════════════ */

.page-transition {
  will-change: opacity, transform;
}

.page-enter {
  animation: pageEnter 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.page-exit {
  animation: pageExit 0.2s cubic-bezier(0.4, 0, 1, 1) both;
}

@keyframes pageEnter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pageExit {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(-8px);
  }
}

/* ══════════════════════════════════════════
   SKELETON LOADING
   ══════════════════════════════════════════ */

.skeleton {
  background: linear-gradient(
    90deg,
    #f1f5f9 25%,
    #e2e8f0 37%,
    #f1f5f9 63%
  );
  background-size: 400% 100%;
  animation: skeletonPulse 1.4s ease infinite;
  border-radius: 8px;
}

/* ══════════════════════════════════════════
   SHIMMER BADGE
   ══════════════════════════════════════════ */

.shimmer-badge {
  background: linear-gradient(
    110deg,
    transparent 25%,
    rgba(255, 255, 255, 0.3) 37%,
    transparent 63%
  );
  background-size: 300% 100%;
  animation: shimmer 2.5s ease-in-out infinite;
}

/* ══════════════════════════════════════════
   HEADER SCROLL TRANSITIONS
   ══════════════════════════════════════════ */

.header-scrolled {
  @apply shadow-lg bg-white/95;
}

.header-scrolled .header-logo {
  @apply text-2xl;
}

/* ══════════════════════════════════════════
   REDUCED MOTION
   ══════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  [data-reveal] {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }

  .page-enter,
  .page-exit {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
}
</file>

