        { id: 'ORD002', customer: 'Tran Thi B', total: '890,000', status: 'Processing', date: '2026-03-11' },
        { id: 'ORD003', customer: 'Le Van C', total: '2,100,000', status: 'Pending', date: '2026-03-10' },
