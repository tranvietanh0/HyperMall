      - DB_PORT=3306
      - DB_USERNAME=${DB_USERNAME:-root}
      - DB_PASSWORD=${DB_PASSWORD:-root}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - JWT_SECRET=${JWT_SECRET}
    depends_on:
      config-server:
        condition: service_healthy
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - hypermall-network
    restart: unless-stopped
    deploy:
      replicas: 2
      resources:
        limits:
          memory: 512M

  product-service:
    build:
      context: ../../backend/product-service
      dockerfile: Dockerfile
    container_name: hypermall-product-service
    environment:
      - SPRING_PROFILES_ACTIVE=prod
      - CONFIG_SERVER_HOST=config-server
      - EUREKA_URI=http://eureka:eureka123@service-registry:8761/eureka/
      - DB_HOST=mysql
      - DB_PORT=3306
      - DB_USERNAME=${DB_USERNAME:-root}
      - DB_PASSWORD=${DB_PASSWORD:-root}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
    depends_on:
      config-server:
        condition: service_healthy
      mysql:
        condition: service_healthy
    networks:
      - hypermall-network
    restart: unless-stopped
    deploy:
      replicas: 2
      resources:
        limits:
          memory: 512M

  order-service:
    build:
      context: ../../backend/order-service
      dockerfile: Dockerfile
    container_name: hypermall-order-service
    environment:
      - SPRING_PROFILES_ACTIVE=prod
      - CONFIG_SERVER_HOST=config-server
      - EUREKA_URI=http://eureka:eureka123@service-registry:8761/eureka/
      - DB_HOST=mysql
      - DB_PORT=3306
      - DB_USERNAME=${DB_USERNAME:-root}
      - DB_PASSWORD=${DB_PASSWORD:-root}
      - RABBITMQ_HOST=rabbitmq
    depends_on:
      config-server:
        condition: service_healthy
      mysql:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    networks:
      - hypermall-network
    restart: unless-stopped
    deploy:
      replicas: 2
      resources:
        limits:
          memory: 512M

  # Frontend
  frontend:
    build:
      context: ../../frontend/hypermall-web
      dockerfile: Dockerfile
    container_name: hypermall-frontend
    ports:
      - "80:80"
    depends_on:
      - api-gateway
    networks:
      - hypermall-network
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 128M

volumes:
  mysql_data:
  redis_data:
  rabbitmq_data:
  elasticsearch_data:

networks:
  hypermall-network:
    driver: bridge
