                >
                  <PencilIcon className="w-4 h-4" />
                </button>
                {!address.isDefault && (
                  <button
                    type="button"
                    onClick={(event) => {
                      event.preventDefault()
                      onDeleteAddress(address.id)
                    }}
                    className="p-1.5 text-gray-400 hover:text-red-500 rounded"
                  >
                    <TrashIcon className="w-4 h-4" />
                  </button>
