        return new OpenAPI()
                .info(new Info()
                        .title("HyperMall Analytics Service API")
                        .version("1.0")
                        .description("Analytics tracking and reporting service"))
                .addSecurityItem(new SecurityRequirement().addList("Bearer Authentication"))
                .components(new Components()
                        .addSecuritySchemes("Bearer Authentication",
                                new SecurityScheme()
                                        .type(SecurityScheme.Type.HTTP)
                                        .scheme("bearer")
                                        .bearerFormat("JWT")));
    }
}
